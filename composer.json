{
    "name": "gijsrommers/smstools-notifier",
    "description": "SMSTools transport for Symfony Notifier",
    "type": "symfony-notifier-bridge",
    "license": "MIT",
    "keywords": [
        "sms",
        "smstools",
        "symfony",
        "notifier"
    ],
    "authors": [
        {
            "name": "Gijs Rommers",
            "email": "gijs@ibeauty.be"
        }
    ],
    "require": {
        "php": "^8.2",
        "symfony/event-dispatcher-contracts": "^3.5",
        "symfony/http-client-contracts": "^3.5",
        "symfony/notifier": "^7.4 || ^8.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5 || ^12.0",
        "symfony/http-client": "^7.4 || ^8.0",
        "symfony/webhook": "^7.4 || ^8.0"
    },
    "suggest": {
        "symfony/webhook": "Required to consume and verify SMSTools delivery webhooks."
    },
    "autoload": {
        "psr-4": {
            "GijsRommers\\SmstoolsNotifier\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "GijsRommers\\SmstoolsNotifier\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
